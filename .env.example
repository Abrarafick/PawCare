# Environment Variables for PawCare

# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT .env TO GIT.
# ============================================================

# ─── Django Core ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=your-very-secret-key-here

# 'development' or 'production'
DJANGO_SETTINGS_MODULE=config.settings.development

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames in production
# e.g., ALLOWED_HOSTS=pawcare.yourdomain.com,www.pawcare.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ────────────────────────────────────────────────
DB_NAME=pawcare
DB_USER=pawcare_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ─── JWT Authentication ──────────────────────────────────────
# Access token lifetime in minutes (default: 15)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token lifetime in days (default: 7)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── File Storage ────────────────────────────────────────────
# 'local' for development (files stored in private_media/)
# 'b2' for Backblaze B2 (production)
# 's3' for AWS S3 or S3-compatible service (production)
STORAGE_BACKEND=local

# Maximum file upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# Local private media root (used when STORAGE_BACKEND=local)
# This path must NOT be inside STATIC_ROOT or any public-serving directory
PRIVATE_MEDIA_ROOT=./private_media

# ─── Backblaze B2 (production, optional) ─────────────────────
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_REGION=

# ─── Cloudflare R2 (production, optional alternative) ────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── CORS ────────────────────────────────────────────────────
# Frontend origin(s) allowed to make API requests
# In development: http://localhost:5173 (Vite default)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Email (optional — for password reset) ───────────────────
# Leave blank to disable email features in development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@pawcare.example.com

# ─── Frontend (for React build) ──────────────────────────────
# Backend API base URL used by the React frontend
VITE_API_BASE_URL=http://localhost:8000/api

# ─── Timezone ────────────────────────────────────────────────
# Used for consistent date comparisons in vaccination status logic
DJANGO_TIME_ZONE=UTC

