# ========================================================
# PawCare Production Environment Variables Template
# ========================================================

# --- Django Core Settings ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-strong-random-key-here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# --- Database (Neon PostgreSQL) ---
# Format: postgresql://<user>:<password>@<ep-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- CORS & Frontend Connection ---
# Set this to your deployed Vercel URL
CORS_ALLOWED_ORIGINS=https://pawcare.vercel.app,https://pawcare-frontend.vercel.app

# --- Private File Storage (Cloudflare R2 / AWS S3) ---
# Set STORAGE_BACKEND=r2 or s3 to enable persistent cloud object storage
STORAGE_BACKEND=local
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=pawcare-private-vault
